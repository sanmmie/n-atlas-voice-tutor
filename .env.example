# ---------------------------------------------------------------------------
# N-ATLaS configuration. Copy to .env.local and fill in.
#
# Compliance rule enforced in src/lib/natlas/config.ts: NATLAS_LLM_MODEL must be an
# official NCAIR1 checkpoint. The process refuses to start otherwise, because NAIC
# disqualifies submissions that wrap a non-N-ATLaS model.
# ---------------------------------------------------------------------------

# --- N-ATLaS LLM: NCAIR1/N-ATLaS (Llama-3 8B fine-tune) ---------------------
# `openai-compatible`  -> any server exposing /v1/chat/completions for the official
#                         weights (llama.cpp `llama-server`, vLLM, TGI, Modal, RunPod)
# `hf-inference-endpoint` -> a Hugging Face Inference Endpoint running NCAIR1/N-ATLaS
NATLAS_LLM_PROVIDER=openai-compatible
NATLAS_LLM_BASE_URL=http://127.0.0.1:8080/v1
NATLAS_LLM_MODEL=NCAIR1/N-ATLaS
# NATLAS_LLM_API_KEY=
NATLAS_LLM_MAX_TOKENS=220
NATLAS_LLM_TEMPERATURE=0.4
NATLAS_LLM_TIMEOUT_MS=120000

# --- N-ATLaS ASR: NCAIR1/{Hausa,Igbo,Yoruba}-ASR -----------------------------
# `service`   -> the FastAPI service in asr-service/ (recommended)
# `hf-router` -> Hugging Face serverless inference on the same NCAIR1 repos
NATLAS_ASR_PROVIDER=service
NATLAS_ASR_BASE_URL=http://127.0.0.1:8000
# NATLAS_ASR_API_KEY=
# HF_TOKEN=hf_...        # required for hf-router and for pulling gated checkpoints
NATLAS_ASR_TIMEOUT_MS=120000

# --- Interaction log store --------------------------------------------------
# jsonl: append-only files under LOG_DIR (self-hosted / VPS)
# postgres: DATABASE_URL (Vercel and other serverless platforms)
LOG_DRIVER=jsonl
LOG_DIR=./data
# DATABASE_URL=postgres://...

# --- Tutor topic guard ------------------------------------------------------
TUTOR_SAFETY_ENABLED=true

# --- Protects /api/export (full transcripts) --------------------------------
ADMIN_TOKEN=change-me-before-deploying
