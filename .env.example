# ---------------------------------------------------------------------------
# N-ATLaS Voice Tutor — environment
#
#   cp .env.example .env.local
#
# Every NATLAS_* value below is validated at load time by src/lib/natlas/config.ts.
# If a value is wrong the process refuses to start and names the exact field,
# which is deliberate: NAIC disqualifies submissions that wrap a non-N-ATLaS
# model, so NATLAS_LLM_MODEL must carry the NCAIR1/ prefix. ADMIN_TOKEN and
# LOG_DIR are read directly rather than through that schema.
#
# NATLAS_ASR_API_KEY must be byte-for-byte the NATLAS_ASR_API_KEY in the Modal
# `natlas-hf` secret. If the two differ, every POST /transcribe returns 401 and
# every voice turn fails. /api/health only catches this once the ASR app is
# redeployed with the /health `auth` field; until then verify with an
# authenticated POST /transcribe (see docs/deployment.md section 4).
#
# N-ATLAS IS GATED. Before any download works you must be signed in to Hugging
# Face and have accepted the conditions on ALL of:
#   https://huggingface.co/NCAIR1/N-ATLaS
#   https://huggingface.co/NCAIR1/Hausa-ASR
#   https://huggingface.co/NCAIR1/Igbo-ASR
#   https://huggingface.co/NCAIR1/Yoruba-ASR
#   https://huggingface.co/NCAIR1/NigerianAccentedEnglish
# ---------------------------------------------------------------------------


# ==== Modal deployment secrets (not read by this app, but required to build them)
#
# The Modal secret `natlas-hf` must contain all three, created once with:
#   modal secret create natlas-hf HF_TOKEN=hf_... NATLAS_LLM_API_KEY=... NATLAS_ASR_API_KEY=...
# HF_TOKEN needs read access to the five gated NCAIR1 repos listed below.
# PRELOAD_LANGUAGES (optional, asr-service only) preloads checkpoints at boot;
# unset, the first /transcribe pays the model load.
#
# ==== N-ATLaS LLM (NCAIR1/N-ATLaS, Llama-3 8B fine-tune) ====================

# openai-compatible | hf-inference-endpoint
# Use `openai-compatible` for llama.cpp, vLLM, TGI, Modal or RunPod.
NATLAS_LLM_PROVIDER=openai-compatible

# MUST end in /v1 — the client appends /chat/completions and the health probe
# appends /models. A base URL without /v1 will 404.
#   local llama.cpp : http://127.0.0.1:8080/v1
#   Modal           : https://<workspace>--natlas-llm-server.modal.direct/v1
NATLAS_LLM_BASE_URL=http://127.0.0.1:8080/v1

# MUST be an official NCAIR1 checkpoint. Anything else throws at startup.
NATLAS_LLM_MODEL=NCAIR1/N-ATLaS

# REQUIRED when the endpoint enforces auth. `scripts/modal_llm.py` passes
# --api-key to vLLM, so this MUST equal NATLAS_LLM_API_KEY in the `natlas-hf`
# Modal secret, and /api/health will 401 without it. Leave blank only for an
# unauthenticated local llama-server.
NATLAS_LLM_API_KEY=

# Capped at 4096 by the schema; 220-260 suits spoken tutor replies.
NATLAS_LLM_MAX_TOKENS=220
NATLAS_LLM_TEMPERATURE=0.4

# A cold Modal container takes 2-3 minutes to boot, which exceeds this timeout
# and also exceeds Vercel's function limit. Keep the endpoint warm before a demo.
NATLAS_LLM_TIMEOUT_MS=120000


# ==== N-ATLaS ASR (NCAIR1/{Hausa,Igbo,Yoruba}-ASR) =========================

# The only supported transport is `service`: the FastAPI app in asr-service/.
NATLAS_ASR_PROVIDER=service

# The asr-service/ FastAPI app. The client posts to {base}/transcribe and
# requires a JSON reply containing BOTH `text` and `model`.
#   local docker : http://127.0.0.1:8000
#   Modal        : https://<workspace>--natlas-asr-server.modal.direct
NATLAS_ASR_BASE_URL=http://127.0.0.1:8000

# Shared secret; must match NATLAS_ASR_API_KEY on the service host.
NATLAS_ASR_API_KEY=

NATLAS_ASR_TIMEOUT_MS=120000

# What MediaRecorder produces on most Android + Chrome.
NATLAS_ASR_MIME=audio/webm;codecs=opus


# ==== Interaction log store (the NAIC validation evidence) ==================

# jsonl    -> writes to LOG_DIR on disk (single VPS / local)
# postgres -> DATABASE_URL (REQUIRED on Vercel; its filesystem is ephemeral and
#             a redeploy or cold start will wipe a jsonl log)
# memory   -> process memory only, lost on restart. Tests only.
LOG_DRIVER=jsonl
LOG_DIR=./data

# Required when LOG_DRIVER=postgres. Apply the schema once:
#   psql "$DATABASE_URL" -f scripts/schema.sql
DATABASE_URL=


# ==== Tutor safety ==========================================================

# Deterministic pre/post topic guard. true in every environment.
TUTOR_SAFETY_ENABLED=true


# ==== Admin ================================================================

# Protects /validation summaries and GET /api/export, which returns full learner
# transcripts.
# Generate with: openssl rand -hex 24
# Set this before sharing any deployment URL.
ADMIN_TOKEN=
